t-center\">\n                <div class=\"w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold ${step >= 1 ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-500'} mx-auto\">\n                  <i class=\"fa-solid fa-check\"></i>\n                </div>\n                <p class=\"text-[11px] font-semibold text-slate-700 mt-1.5\">Submitted</p>\n                <p class=\"text-[10px] text-slate-400\">Issue Logged</p>\n              </div>\n\n              <!-- Step 2 -->\n              <div class=\"relative z-10 text-center\">\n                <div class=\"w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold ${step >= 2 ? 'bg-sky-600 text-white' : 'bg-slate-200 text-slate-500'} mx-auto\">\n                  ${step >= 2 ? '<i class=\"fa-solid fa-person-digging\"></i>' : '2'}\n                </div>\n                <p class=\"text-[11px] font-semibold text-slate-700 mt-1.5\">In Progress</p>\n                <p class=\"text-[10px] text-slate-400\">Crew Assigned</p>\n              </div>\n\n              <!-- Step 3 -->\n              <div class=\"relative z-10 text-center\">\n                <div class=\"w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold ${step === 3 ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-500'} mx-auto\">\n                  ${step === 3 ? '<i class=\"fa-solid fa-circle-check\"></i>' : '3'}\n                </div>\n                <p class=\"text-[11px] font-semibold text-slate-700 mt-1.5\">Resolved</p>\n                <p class=\"text-[10px] text-slate-400\">Fixed & Verified</p>\n              </div>\n            </div>\n          </div>\n\n          <!-- Grievance Info -->\n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs bg-slate-50 p-4 rounded-xl border border-slate-200\">\n            <div>\n              <p class=\"text-slate-400 font-semibold uppercase\">Category</p>\n              <p class=\"font-bold text-slate-800 text-sm mt-0.5\">${found.category}</p>\n            </div>\n            <div>\n              <p class=\"text-slate-400 font-semibold uppercase\">Landmark / Location</p>\n              <p class=\"font-bold text-slate-800 text-sm mt-0.5\">${found.landmark}</p>\n            </div>\n            <div class=\"md:col-span-2\">\n              <p class=\"text-slate-400 font-semibold uppercase\">Issue Summary</p>\n              <p class=\"text-slate-700 mt-0.5\">${found.title}</p>\n              <p class=\"text-slate-500 text-[11px] mt-1\">${found.description}</p>\n            </div>\n          </div>\n\n          ${found.photo ? `\n            <div>\n              <p class=\"text-xs font-bold text-slate-500 uppercase tracking-wider mb-2\">Attached Site Evidence</p>\n              <img src=\"${found.photo}\" alt=\"Site Photo\" class=\"h-48 w-full object-cover rounded-xl border border-slate-200\">\n            </div>\n          ` : ''}\n\n          <!-- Official Administrative Remarks -->\n          <div class=\"bg-amber-50 border border-amber-200 rounded-xl p-4 text-xs space-y-1\">\n            <div class=\"flex items-center space-x-1.5 text-amber-900 font-bold\">\n              <i class=\"fa-solid fa-clipboard-user\"></i>\n              <span>Municipal / Ward Officer Action Note:</span>\n            </div>\n            <p class=\"text-amber-800 leading-relaxed\">${found.remarks || \"Under inspection by ward maintenance squad.\"}</p>\n          </div>\n\n        </div>\n      `;\n      resultContainer.classList.remove('hidden');\n    }\n\n    // Helper for status styles\n    function getStatusBadge(status) {\n      if (status === \"Resolved\") return \"bg-emerald-100 text-emerald-800 border border-emerald-300\";\n      if (status === \"In Progress\") return \"bg-sky-100 text-sky-800 border border-sky-300\";\n      return \"bg-amber-100 text-amber-800 border border-amber-300\";\n    }\n\n    // Public Issues Feed Filtering & Rendering\n    function filterStatus(status) {\n      activeStatusFilter = status;\n      ['all', 'Submitted', 'InProgress', 'Resolved'].forEach(s => {\n        const btn = document.getElementById(`filter-${s}`);\n        if (btn) {\n          if ((status === 'all' && s === 'all') || (status === 'Submitted' && s === 'Submitted') || (status === 'In Progress' && s === 'InProgress') || (status === 'Resolved' && s === 'Resolved')) {\n            btn.className = \"filter-tab px-3 py-1.5 rounded-md bg-white text-govNavy shadow-sm\";\n          } else {\n            btn.className = \"filter-tab px-3 py-1.5 rounded-md text-slate-600 hover:text-govNavy\";\n          }\n        }\n      });\n      applyFilters();\n    }\n\n    function applyFilters() {\n      const catFilter = document.getElementById('feed-category-filter').value;\n      const issues = getIssues();\n\n      const filtered = issues.filter(issue => {\n        const matchesStatus = (activeStatusFilter === 'all') || (issue.status === activeStatusFilter);\n        const matchesCat = (catFilter === 'all') || (issue.category === catFilter);\n        return matchesStatus && matchesCat;\n      });\n\n      renderGrid(filtered);\n    }\n\n    function renderGrid(issuesList) {\n      const grid = document.getElementById('grievances-grid');\n      if (!grid) return;\n\n      if (issuesList.length === 0) {\n        grid.innerHTML = `\n          <div class=\"col-span-full py-12 text-center text-slate-400 bg-white rounded-xl border border-dashed border-slate-300\">\n            <i class=\"fa-solid fa-inbox text-4xl mb-2 text-slate-300\"></i>\n            <p class=\"text-sm font-semibold text-slate-600\">No issues found matching the selected filter</p>\n            <p class=\"text-xs text-slate-400 mt-1\">Try switching back to 'All' or choose another category</p>\n          </div>\n        `;\n        return;\n      }\n\n      grid.innerHTML = issuesList.map(item => `\n        <div class=\"bg-white rounded-xl shadow-sm hover:shadow-md transition border border-slate-200 overflow-hidden flex flex-col justify-between\">\n          <div>\n            ${item.photo ? `\n              <div class=\"h-40 w-full overflow-hidden bg-slate-100\">\n                <img src=\"${item.photo}\" alt=\"${item.title}\" class=\"w-full h-full object-cover\">\n              </div>\n            ` : `\n              <div class=\"h-24 w-full bg-slate-50 flex items-center justify-center text-slate-300 border-b border-slate-100\">\n                <i class=\"fa-solid fa-camera-slash text-2xl\"></i>\n              </div>\n            `}\n            \n            <div class=\"p-4 space-y-2.5\">\n              <div class=\"flex items-center justify-between text-xs\">\n                <span class=\"font-mono text-[11px] font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded\">${item.id}</span>\n                <span class=\"text-[11px] font-semibold px-2 py-0.5 rounded ${getStatusBadge(item.status)}\">\n                  ● ${item.status}\n                </span>\n              </div>\n\n              <h4 class=\"font-bold text-slate-800 text-sm leading-snug\">${item.title}</h4>\n              \n              <div class=\"flex items-center text-xs text-slate-500 space-x-1.5\">\n                <i class=\"fa-solid fa-location-dot text-rose-500\"></i>\n                <span class=\"truncate\">${item.landmark}</span>\n              </div>\n\n              <p class=\"text-xs text-slate-600 line-clamp-2 leading-relaxed\">${item.description}</p>\n            </div>\n          </div>\n\n          <div class=\"p-4 pt-0\">\n            <div class=\"pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400\">\n              <span><i class=\"fa-regular fa-clock mr-1\"></i> ${item.date}</span>\n              <button onclick=\"switchTab('track'); fillTracking('${item.id}'); searchTicket();\" class=\"text-sky-700 hover:text-sky-900 font-semibold\">\n                Inspect Details →\n              </button>\n            </div>\n          </div>\n        </div>\n      `).join('');\n    }\n\n    function renderIssues() {\n      applyFilters();\n    }\n\n    // Update Statistics\n    function updateStats() {\n      const issues = getIssues();\n      const total = issues.length;\n      const resolved = issues.filter(i => i.status === \"Resolved\").length;\n      const progress = issues.filter(i => i.status === \"In Progress\").length;\n      const submitted = issues.filter(i => i.status === \"Submitted\").length;\n\n      const totalEl = document.getElementById('stat-total');\n      const resolvedEl = document.getElementById('stat-resolved');\n      const progressEl = document.getElementById('stat-progress');\n      const submittedEl = document.getElementById('stat-submitted');\n\n      if (totalEl) totalEl.textContent = total;\n      if (resolvedEl) resolvedEl.textContent = resolved;\n      if (progressEl) progressEl.textContent = progress;\n      if (submittedEl) submittedEl.textContent = submitted;\n    }\n\n    // On Load\n    document.addEventListener('DOMContentLoaded', () => {\n      getIssues();\n      updateStats();\n      renderIssues();\n    });\n  </script>\n</body>\n</html>","Path":"C:\\Users\\pinkm\\.gemini\\antigravity\\brain\\a5b231a2-4f86-4de8-aef6-e2920d9db8fb\\civic_portal.html"}}]}
